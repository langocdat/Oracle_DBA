Sub FixHeadingSpaceAndAlignment()
    Dim para As Paragraph
    Dim count As Long
    count = 0
    
    ' Duyệt qua toàn bộ đoạn văn trong tài liệu
    For Each para In ActiveDocument.Paragraphs
        ' Kiểm tra nếu đoạn văn là Level 2 hoặc Level 3
        If para.OutlineLevel = wdOutlineLevel2 Or para.OutlineLevel = wdOutlineLevel3 Then
            
            ' Đưa khoảng cách lề trái và lề thụt dòng về sát đầu (0 mm)
            para.LeftIndent = MillimetersToPoints(0)
            para.FirstLineIndent = MillimetersToPoints(0)
            
            ' Xóa tất cả các điểm dừng Tab thủ công trên đoạn văn này để tránh chữ bị nhảy
            para.TabStops.ClearAll
            
            ' Nếu đề mục đang nằm trong một danh sách đánh số tự động
            If para.Range.ListFormat.ListType <> wdListNoNumbering Then
                With para.Range.ListFormat.ListTemplate.ListLevels(para.OutlineLevel)
                    ' Căn vị trí số tự động ra sát lề trái (0 mm)
                    .NumberPosition = MillimetersToPoints(0)
                    ' Căn vị trí văn bản ra sát lề trái (0 mm)
                    .TextPosition = MillimetersToPoints(0)
                    ' QUAN TRỌNG: Đổi ký tự phía sau số từ Tab thành Dấu cách (Space)
                    .TrailingCharacter = wdTrailingSpace
                End With
            End If
            
            count = count + 1
        End If
    Next para
    
    MsgBox "Đã căn lề sát đầu dòng và sửa khoảng cách chữ cho " & count & " đề mục!", vbInformation, "done"
End Sub

