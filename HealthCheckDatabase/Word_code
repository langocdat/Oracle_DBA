Replace cỡ chữ
=====
Sub ThayDoiCoChuBang()
    Dim tbl As Table
    For Each tbl In ActiveDocument.Tables
        tbl.Range.Font.Size = 12
    Next tbl
    MsgBox "Đã thay đổi cỡ chữ của tất cả các bảng thành 12!", vbInformation, "Hoàn thành"
End Sub




=====
Fix chiều cao cột
=====
Sub DatChieuCaoLinhDongVaCongThemKhoangTrong()
    Dim tbl As Table
    
    ' Duyệt qua từng bảng trong toàn bộ tài liệu
    For Each tbl In ActiveDocument.Tables
        
        ' 1. Cài đặt chiều cao tối thiểu cho các hàng
        With tbl.Rows
            .HeightRule = wdRowHeightAtLeast ' Chế độ tự phình to khi nhiều chữ
            .Height = MillimetersToPoints(8) ' Mức sàn tối thiểu là 8mm
        End With
        
        ' 2. Cộng thêm khoảng trống 0.2mm bằng cách chỉnh lề ô (Cell Margins)
        ' Chia đều lề trên 0.1mm và lề dưới 0.1mm để chữ luôn nằm giữa ô và thoáng đãng
        With tbl
            .TopPadding = MillimetersToPoints(0.1)    ' Lề trên ô
            .BottomPadding = MillimetersToPoints(0.1) ' Lề dưới ô
        End With
        
    Next tbl
    
    ' Thông báo hoàn thành
    MsgBox "Đã đặt chiều cao tối thiểu 8mm và cộng thêm 0.2mm khoảng trống cho tất cả các bảng!", vbInformation, "Hoàn thành"
End Sub

