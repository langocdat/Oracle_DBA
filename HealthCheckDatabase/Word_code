Sub DoiMauDongHeaderDauTien()
    Dim tbl As Table
    
    ' Vòng lặp chạy qua từng bảng trong toàn bộ file Word
    For Each tbl In ActiveDocument.Tables
        On Error Resume Next ' Bỏ qua lỗi nếu bảng có cấu trúc đặc biệt (như ô bị gộp)
        
        ' Chỉ tác động vào hàng số 1 (Hàng tiêu đề/Header đầu tiên)
        ' Bạn hãy thay đổi 3 số trong mã RGB bên dưới để ra màu mong muốn
        tbl.Rows(1).Cells.Shading.BackgroundPatternColor = RGB(31, 56, 100)
        
        ' Tùy chọn: Đổi màu chữ của hàng đầu tiên thành màu Trắng cho dễ đọc
        tbl.Rows(1).Range.Font.ColorIndex = wdWhite
        
        On Error GoTo 0
    Next tbl
    
    MsgBox "Đã đổi màu dòng header đầu tiên thành công!", vbInformation, "Hoàn thành"
End Sub
